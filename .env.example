# Copie para .env.local e preencha. NUNCA comite .env.local.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública (publishable/anon). Segura para o browser: a RLS protege os dados.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Alternativa legada ao nome acima:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role / secret key — SOMENTE servidor/scripts (seed e E2E). Nunca prefixe com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Connection string do Postgres para `npm run db:push` (Project Settings → Database)
SUPABASE_DB_URL=postgresql://postgres:SENHA@db.SEU-PROJETO.supabase.co:5432/postgres

# URL pública do app (links de convite e e-mails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Senha das contas sintéticas criadas pelo seed (escolha uma senha forte local)
SEED_USER_PASSWORD=

# --- Opcional: assistente com IA (Claude), apenas no servidor ---
# Sem esta chave, o assistente usa respostas roteirizadas.
ANTHROPIC_API_KEY=

# --- E2E ---
# Defina E2E_SUPABASE=1 para executar as jornadas autenticadas (exige seed aplicado).
E2E_SUPABASE=
E2E_BASE_URL=http://localhost:3000
