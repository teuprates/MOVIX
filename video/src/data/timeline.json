  "lines": [
    {
      "id": "p1",
      "scene": "problema",
      "text": "Gerenciar uma frota de locação parece simples.",
      "start": 0.9,
      "end": 3.806,
      "cues": [
        0.9,
        2.84
      ]
    },
    {
      "id": "p2",
      "scene": "problema",
      "text": "Até os veículos ficarem numa planilha, os contratos em outra pasta, e as parcelas em conversas espalhadas.",
      "start": 4.267,
      "end": 10.773,
      "cues": [
        4.267,
        6.517,
        8.377
      ]
    },
    {
      "id": "p3",
      "scene": "problema",
      "text": "Quem devolve o carro esta semana? Qual parcela já venceu?",
      "start": 11.267,
      "end": 14.362,
      "cues": [
        11.267,
        13.052
      ]
    },
    {
      "id": "p4",
      "scene": "problema",
      "text": "No fim, cada decisão vira uma busca.",
      "start": 14.867,
      "end": 17.05,
      "cues": [
        14.867,
        16.227
      ]
    },
    {
      "id": "v1",
      "scene": "virada",
      "text": "Conheça o MOVIX.",
      "start": 19.1,
      "end": 20.263,
      "cues": [
        19.1
      ]
    },
    {
      "id": "v2",
      "scene": "virada",
      "text": "A plataforma que reúne veículos, contratos, locatários e financeiro da sua locadora, em um só lugar.",
      "start": 21.0,
      "end": 26.73,
      "cues": [
        21.0,
        23.255,
        25.765
      ]
    },
    {
      "id": "d1",
      "scene": "painel",
      "text": "No painel, a frota aparece como está agora: disponível, reservada, alugada ou em manutenção.",
      "start": 28.133,
      "end": 33.777,
      "cues": [
        28.133,
        30.453,
        32.023
      ]
    },
    {
      "id": "d2",
      "scene": "painel",
      "text": "E o que precisa de atenção já vem na frente.",
      "start": 34.233,
      "end": 37.007,
      "cues": [
        34.233,
        35.863
      ]
    },
    {
      "id": "f1",
      "scene": "frota",
      "text": "Cada veículo tem status, saúde estimada e valor da diária, sempre à mão.",
      "start": 38.3,
      "end": 42.647,
      "cues": [
        38.3,
        40.76
      ]
    },
    {
      "id": "c1",
      "scene": "contratos",
      "text": "Os contratos mostram período, valor e situação, com aceite eletrônico do locatário.",
      "start": 43.933,
      "end": 48.778,
      "cues": [
        43.933,
        46.933
      ]
    },
    {
      "id": "n1",
      "scene": "financeiro",
      "text": "No financeiro, receitas, despesas e lucro estimado por veículo ficam lado a lado.",
      "start": 50.067,
      "end": 55.041,
      "cues": [
        50.067,
        52.447,
        53.887
      ]
    },
    {
      "id": "m1",
      "scene": "mobile",
      "text": "E tudo isso cabe no celular.",
      "start": 56.333,
      "end": 58.094,
      "cues": [
        56.333
      ]
    },
    {
      "id": "m2",
      "scene": "mobile",
      "text": "O MOVIX pode ser instalado como aplicativo, para o proprietário e para o locatário.",
      "start": 58.5,
      "end": 63.224,
      "cues": [
        58.5,
        61.225
      ]
    },
    {
      "id": "e1",
      "scene": "fechamento",
      "text": "Mais controle.",
      "start": 64.733,
      "end": 65.789,
      "cues": [
